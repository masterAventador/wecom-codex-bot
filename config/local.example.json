{
  "security": {
    "allowedUserIds": ["你的企微userid"],
    "allowedChatIds": ["允许触发机器人的群chatid"]
  },
  "repository": {
    "path": "/Users/你的用户名/代码/electron-project",
    "baseBranch": "dev",
    "remote": "origin",
    "fetchBeforeTask": true,
    "installCommand": ["npm", "ci"],
    "testCommand": ["npm", "test"],
    "buildCommand": ["npm", "run", "dist"],
    "artifactGlobs": ["release/*.dmg", "release/*.exe"]
  },
  "codex": {
    "binary": "/opt/homebrew/bin/codex",
    "timeoutMinutes": 45
  },
  "git": {
    "commitChanges": true,
    "pushBranches": false,
    "branchPrefix": "bot",
    "authorName": "企微修复机器人",
    "authorEmail": "wecom-codex-bot@localhost"
  },
  "runtime": {
    "directory": "/Users/你的用户名/代码/wecom-codex-bot/.runtime"
  },
  "artifact": {
    "provider": "cos",
    "cos": {
      "bucket": "example-1234567890",
      "region": "ap-beijing",
      "keyPrefix": "electron-builds",
      "urlExpiresSeconds": 259200
    }
  }
}
